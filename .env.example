# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/shipora?sslmode=require

# ─── Security & Encryption ───────────────────────────────────
# 32-byte hex string (64 characters) for AES-256-GCM encryption of cloud credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Clerk Auth ──────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── GitHub App ──────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional PAT fallback for public repo lookups to bypass IP rate limits
GITHUB_TOKEN=

# ─── Temporal Cloud ──────────────────────────────────────────
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_MTLS_TLS_CERT=
TEMPORAL_MTLS_TLS_KEY=

# ─── AWS ─────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECS_CLUSTER_ARN=
AWS_CODEBUILD_PROJECT_NAME=shipora-build
ECR_REGISTRY=

# ─── Upstash Redis (Phase 4 — SSE Log Streaming & Pub/Sub) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Internal ────────────────────────────────────────────────
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
